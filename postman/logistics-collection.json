          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/orders", "host": ["{{baseUrl}}"], "path": ["api","orders"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": 1,\n  \"items\": [\n    {\n      \"sku\": \"SKU-001\",\n      \"productName\": \"Widget A\",\n      \"quantity\": 10,\n      \"unitPrice\": 25.00\n    }\n  ],\n  \"notes\": \"Handle with care\"\n}"
            }
          }
        },
        {
          "name": "Update Order Status",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/orders/1/status", "host": ["{{baseUrl}}"], "path": ["api","orders","1","status"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"CONFIRMED\"\n}"
            },
            "description": "Valid statuses: CREATED, CONFIRMED, STOCK_RESERVED, PROCESSING, READY_TO_SHIP, SHIPPED, DELIVERED, RETURNED, FAILED, CANCELLED"
          }
        }
      ]
    },
